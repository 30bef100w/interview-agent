# 复制为项目根目录 .env 后修改
# cp deploy/env.example .env

# ---------- 必填 ----------
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-v4-flash
JWT_SECRET=请改成至少32位随机字符串
POSTGRES_PASSWORD=请改成强密码

# ---------- 应用 ----------
APP_ENV=production
DEBUG=false
ADMIN_USERNAMES=你的管理员用户名
DEFAULT_PLATFORM_QUOTA=3

# 对外访问域名（用于 CORS；若只走 Nginx 同源可留空）
# PUBLIC_ORIGIN=https://deepask.example.com
CORS_ORIGINS=

# ---------- 数据库 ----------
# 方案 A：使用 compose 内置 Postgres（默认）
DATABASE_URL=postgresql+psycopg2://face_agent:${POSTGRES_PASSWORD}@postgres:5432/face_agent

# 方案 B：使用本机已有 Postgres（Windows Docker 用 host.docker.internal）
# DATABASE_URL=postgresql+psycopg2://user:pass@host.docker.internal:5432/face_agent

# ---------- Redis（会话 checkpoint；留空则回落文件） ----------
REDIS_URL=redis://redis:6379/0

# ---------- 飞书运维告警 ----------
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# FEISHU_WEBHOOK_SECRET=
# ALERT_COOLDOWN_SECONDS=600
# ALERT_RPM_THRESHOLD=180
# HEALTH_CHECK_URL=http://127.0.0.1/api/health

# ---------- 前端 ----------
# 空 = 与 Nginx 同源
NEXT_PUBLIC_API_BASE=
