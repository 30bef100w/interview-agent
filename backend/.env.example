DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# development | production
APP_ENV=development
DEBUG=true

# 生产务必改成随机长字符串
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_DAYS=7

# 本地开发默认 SQLite；生产推荐 PostgreSQL
# DATABASE_URL=sqlite:///./data/face_agent.db
# DATABASE_URL=postgresql+psycopg2://face_agent:your_password@localhost:5432/face_agent

ADMIN_USERNAMES=
DEFAULT_PLATFORM_QUOTA=3

# 逗号分隔；Docker+Nginx 同源反代时可留空
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

WHISPER_MODEL=small

# Redis（会话 checkpoint；本地可留空走文件）
REDIS_URL=

# 飞书群机器人 Webhook（运维告警 / 错标审核满批通知）
FEISHU_WEBHOOK_URL=
# 机器人安全设置勾了「签名校验」时必填
FEISHU_WEBHOOK_SECRET=
FEISHU_TAG_MISMATCH_BATCH=10

# 飞书私聊面试（生产在网页 backend 内收消息；lark-cli 仅本地调试）
# FEISHU_WS_ENABLED=true
# FEISHU_BIND_USERS=ou_xxx:xuyongqi
# FEISHU_SKIP_CODING=true
# 网页飞书登录/绑定 + 事件订阅 Webhook（开放平台应用；勿把真实 Secret 写入仓库）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=
# 事件订阅「Verification Token / Encrypt Key」
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# 运维飞书告警（冷却秒数、流量 RPM 阈值；0=关闭流量告警）
ALERT_COOLDOWN_SECONDS=600
ALERT_RPM_THRESHOLD=180

# health_watchdog.py 使用（服务器 cron）
HEALTH_CHECK_URL=http://127.0.0.1/api/health
HEALTH_FAIL_THRESHOLD=2
