DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选：知乎切题优先用（OpenAI 兼容，或 Anthropic Messages）
# SPLIT_API_KEY=
# SPLIT_BASE_URL=https://zz.aiapi2025.top
# SPLIT_MODEL=claude-sonnet-4-6
# SPLIT_API_STYLE=anthropic
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./data/face_agent.db
ADMIN_USERNAMES=
DEFAULT_PLATFORM_QUOTA=3

# 错标审核队列（可选 RocketMQ；不配则仅 SQLite + logs/tag_mismatch_queue/*.jsonl）
# ROCKETMQ_NAMESRV=127.0.0.1:9876
# ROCKETMQ_TAG_MISMATCH_TOPIC=tag_mismatch_review
# ROCKETMQ_PRODUCER_GROUP=face-agent-tag-mismatch

# 语音上传兜底：tiny|base|small
WHISPER_MODEL=small

